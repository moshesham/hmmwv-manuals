{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moshesham.github.io/hmmwv-manuals/schemas/rag-diagnostic/content-unit.schema.json",
  "title": "RAG Diagnostic Content Unit",
  "description": "Canonical content unit for interactive HMMWV diagnostic retrieval, routing, and grounding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "manual_id",
    "manual_role",
    "mode",
    "source",
    "unit_type",
    "title",
    "text_markdown",
    "text_plain",
    "provenance",
    "taxonomy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "content_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "manual_id": {
      "type": "string"
    },
    "manual_role": {
      "type": "string",
      "enum": [
        "operator",
        "maintenance",
        "parts",
        "engine",
        "other"
      ]
    },
    "mode": {
      "$ref": "#/$defs/mode"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "procedure_task",
        "procedure_step_group",
        "troubleshooting_entry",
        "diagnostic_flow",
        "diagnostic_flow_node",
        "diagnostic_support_panel",
        "reference_section",
        "safety_summary"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "chapter": {
      "type": [
        "string",
        "null"
      ]
    },
    "section": {
      "type": [
        "string",
        "null"
      ]
    },
    "subsection": {
      "type": [
        "string",
        "null"
      ]
    },
    "text_markdown": {
      "type": "string"
    },
    "text_plain": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "safety_blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safetyBlock"
      },
      "default": []
    },
    "initial_setup": {
      "anyOf": [
        {
          "$ref": "#/$defs/initialSetup"
        },
        {
          "type": "null"
        }
      ]
    },
    "procedure_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/procedureStep"
      },
      "default": []
    },
    "follow_on_tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/followOnTask"
      },
      "default": []
    },
    "troubleshooting": {
      "anyOf": [
        {
          "$ref": "#/$defs/troubleshooting"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostic_graph": {
      "anyOf": [
        {
          "$ref": "#/$defs/diagnosticGraph"
        },
        {
          "type": "null"
        }
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "default": []
    },
    "image_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/imageRef"
      },
      "default": []
    },
    "taxonomy": {
      "$ref": "#/$defs/taxonomy"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected_mode",
        "selected_mode",
        "selection_source",
        "confidence_score",
        "persistence_threshold",
        "override_allowed",
        "requires_clarification"
      ],
      "properties": {
        "detected_mode": {
          "type": "string",
          "enum": [
            "operator",
            "maintenance",
            "mixed_or_uncertain"
          ]
        },
        "selected_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "operator",
            "maintenance",
            "mixed_or_uncertain",
            null
          ]
        },
        "selection_source": {
          "type": "string",
          "enum": [
            "inferred",
            "explicit",
            "inherited",
            "system_default"
          ]
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "persistence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "override_allowed": {
          "type": "boolean"
        },
        "automatic_persistence_allowed": {
          "type": "boolean"
        },
        "requires_clarification": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "anchor",
        "heading",
        "line_start",
        "line_end"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "heading": {
          "type": "string"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "safetyBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "warning",
            "caution",
            "note"
          ]
        },
        "text": {
          "type": "string"
        },
        "applies_to": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "initialSetup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicable_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "special_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "materials_parts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "personnel_required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "manual_references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "equipment_condition": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "general_safety_instructions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "procedureStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "text"
      ],
      "properties": {
        "sequence": {
          "type": "string"
        },
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "followOnTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "troubleshooting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symptom": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "escalation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "diagnosticGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_container",
        "nodes",
        "edges",
        "support_panels",
        "render_views"
      ],
      "properties": {
        "flow_container": {
          "$ref": "#/$defs/flowContainer"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticNode"
          },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticEdge"
          },
          "default": []
        },
        "support_panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supportPanel"
          },
          "default": []
        },
        "render_views": {
          "$ref": "#/$defs/renderViews"
        }
      }
    },
    "flowContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_id",
        "entry_node_ids",
        "retrieval_identity"
      ],
      "properties": {
        "flow_id": {
          "type": "string"
        },
        "entry_node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "retrieval_identity": {
          "type": "string"
        },
        "source_span_label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "diagnosticNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_type",
        "text"
      ],
      "properties": {
        "node_id": {
          "type": "string"
        },
        "node_type": {
          "type": "string",
          "enum": [
            "question",
            "action",
            "check",
            "outcome",
            "escalation",
            "reference"
          ]
        },
        "text": {
          "type": "string"
        },
        "support_panel_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "node_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/provenance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "diagnosticEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "from_node_id",
        "to_node_id",
        "condition_label"
      ],
      "properties": {
        "edge_id": {
          "type": "string"
        },
        "from_node_id": {
          "type": "string"
        },
        "to_node_id": {
          "type": "string"
        },
        "condition_label": {
          "type": "string"
        }
      }
    },
    "supportPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "panel_type",
        "content"
      ],
      "properties": {
        "panel_id": {
          "type": "string"
        },
        "panel_type": {
          "type": "string",
          "enum": [
            "instruction",
            "note",
            "warning",
            "caution",
            "measurement_help",
            "reference"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": "string"
        },
        "panel_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/provenance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "renderViews": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retrieval_view",
        "technician_view",
        "default_entry_node_id"
      ],
      "properties": {
        "retrieval_view": {
          "type": "string",
          "enum": [
            "graph_nodes"
          ]
        },
        "technician_view": {
          "type": "string",
          "enum": [
            "guided_path"
          ]
        },
        "default_entry_node_id": {
          "type": "string"
        },
        "preferred_linearization": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "manual_reference",
            "follow_on_reference",
            "cross_manual_reference",
            "image_reference",
            "task_reference",
            "flow_reference",
            "support_panel_reference"
          ]
        },
        "label": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "imageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlled_core",
        "candidate_terms",
        "quarantine_terms",
        "extracted_requirements"
      ],
      "properties": {
        "controlled_core": {
          "$ref": "#/$defs/controlledCore"
        },
        "candidate_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidateTerm"
          },
          "default": []
        },
        "quarantine_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quarantinedTerm"
          },
          "default": []
        },
        "extracted_requirements": {
          "$ref": "#/$defs/extractedRequirements"
        }
      }
    },
    "controlledCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subsystems",
        "maintenance_categories",
        "safety_types"
      ],
      "properties": {
        "subsystems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maintenance_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "candidateTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_type",
        "original_term",
        "normalized_term",
        "confidence_score"
      ],
      "properties": {
        "candidate_type": {
          "type": "string",
          "enum": [
            "symptom",
            "component",
            "alias",
            "ocr_noise"
          ]
        },
        "original_term": {
          "type": "string"
        },
        "normalized_term": {
          "type": "string"
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "canonical_label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "quarantinedTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_type",
        "original_term",
        "normalized_term",
        "confidence_score",
        "quarantine_reason"
      ],
      "properties": {
        "candidate_type": {
          "type": "string",
          "enum": [
            "symptom",
            "component",
            "alias",
            "ocr_noise"
          ]
        },
        "original_term": {
          "type": "string"
        },
        "normalized_term": {
          "type": "string"
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "canonical_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "quarantine_reason": {
          "type": "string",
          "enum": [
            "low_confidence",
            "ambiguous_mapping",
            "ocr_noise",
            "needs_review"
          ]
        }
      }
    },
    "extractedRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "materials"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excerpt",
        "chunk_id",
        "parser_confidence"
      ],
      "properties": {
        "excerpt": {
          "type": "string"
        },
        "chunk_id": {
          "type": "string"
        },
        "metadata_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "parser_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    }
  }
}
